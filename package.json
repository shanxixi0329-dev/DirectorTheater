{
  "name": "director-theater",
  "version": "0.1.14",
  "description": "导演台剧场 - 带会员机制的本地剧本、分镜、提示词与素材工作台",
  "main": "src/main.js",
  "build": {
    "appId": "com.director.theater",
    "productName": "导演台剧场",
    "directories": {
      "output": "installer-output"
    },
    "electronLanguages": [
      "zh-CN",
      "en-US"
    ],
    "files": [
      "src/**/*",
      "package.json",
      "!src/**/*.dtlicense",
      "!src/templates/**",
      "!node_modules/chrome-devtools-mcp/**",
      "!node_modules/docx/dist/**",
      "node_modules/docx/dist/index.cjs",
      "!node_modules/mammoth/mammoth.browser*.js",
      "!node_modules/@types/**",
      "!node_modules/undici-types/**",
      "!node_modules/**/*.d.ts",
      "!node_modules/**/*.d.cts",
      "!node_modules/**/*.map",
      "!node_modules/**/README*",
      "!node_modules/**/CHANGELOG*",
      "!node_modules/**/*.md"
    ],
    "extraResources": [
      {
        "from": "node_modules/chrome-devtools-mcp",
        "to": "chrome-devtools-mcp",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "src/assets/brand-v008/app-icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "artifactName": "DirectorTheater-Setup-${version}-win-x64.${ext}"
    }
  },
  "scripts": {
    "start": "electron .",
    "check": "node scripts/check-all.cjs",
    "test": "node scripts/run-tests.cjs",
    "preflight": "node scripts/release-preflight.cjs",
    "package:win": "electron-builder --win nsis --x64 --publish never",
    "package:win:signed": "node scripts/package-win-signed.cjs"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "electron": "43.2.0",
    "undici-types": "^7.16.0",
    "electron-builder": "26.18.0"
  },
  "dependencies": {
    "chrome-devtools-mcp": "1.7.0",
    "docx": "^9.5.1",
    "mammoth": "^1.9.0"
  },
  "private": true,
  "author": "shanxixi0329-dev",
  "repository": {
    "type": "git",
    "url": "https://github.com/shanxixi0329-dev/DirectorTheater.git"
  }
}
